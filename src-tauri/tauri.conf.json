{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "track",
  "mainBinaryName": "track",
  "version": "../package.json",
  "identifier": "io.github.quantumkeyboard.track",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "~track",
        "width": 1320,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "a minimal, local-first dashboard",
    "longDescription": "a habit tracker, a kanban board, notes, a calendar, insights and plugins as movable, resizable panels on a checkered-paper canvas. everything stays on your device.",
    "copyright": "MIT licensed",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
